    {
      "type": "bargauge",
      "id": 12,
      "title": "PSI per feature - latest batch",
      "description": "How far each audio feature of the latest batch moved from the training data (Population Stability Index): blue below 0.1 (stable), orange 0.1 to 0.2 (moderate), vermillion 0.2 or more (major).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "# AI-generated PromQL (Claude Opus 5.5, Claude Code, 2026-11-15). Computes: each feature's PSI in the latest batch\nspatify_drift_psi",
          "legendFormat": "{{feature}}",
          "instant": true,
          "range": false
        }
      ],
