    {
      "type": "stat",
      "id": 11,
      "title": "latest batch",
      "description": "Whether the latest batch of new tracks drifted from the training data: any feature at PSI 0.2 or more, or two at 0.1 to 0.2. A drifted batch makes the worker retrain.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "# AI-generated PromQL (Claude Opus 5.5, Claude Code, 2026-11-15). Computes: the worker's verdict on the latest batch (1 = drifted)\nspatify_drift_detected",
          "legendFormat": "drift",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "#0072B2"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "✓ no drift",
                  "color": "#0072B2",
                  "index": 0
                },
                "1": {
                  "text": "▲ drifted",
                  "color": "#D55E00",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
