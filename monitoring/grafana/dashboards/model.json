    {
      "type": "timeseries",
      "id": 11,
      "title": "average position of liked and skipped songs",
      "description": "Where in the list (1 = top) the songs listeners liked or skipped were. A good model puts liked songs nearer the top, so the like line sits below the skip line; with a broken model the two meet.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "# AI-generated PromQL (Claude Opus 5.5, Claude Code, 2026-11-15). Computes: the mean list position of liked and of skipped songs over 10 minutes (Summary sum / count)\nsum by (action) (rate(spatify_feedback_rank_sum[10m])) / sum by (action) (rate(spatify_feedback_rank_count[10m]))",
          "legendFormat": "{{action}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "#0072B2"
          },
          "custom": {
            "axisLabel": "position in the list (1 = top) (linear)",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
