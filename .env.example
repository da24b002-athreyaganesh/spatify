# Secrets for docker compose. Copy to .env (never commit .env) and replace every value;
# scripts/make_env.py writes a .env with random values for you.

POSTGRES_USER=spatify
POSTGRES_PASSWORD=change-me

# Admin key for POST /models/rollback and POST /pipeline/trigger (X-API-Key header).
# The gateway only receives its SHA-256, so the key itself never reaches the container:
#   python -c "import hashlib, sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" KEY
SPATIFY_API_KEY=change-me
API_KEY_SHA256=change-me
